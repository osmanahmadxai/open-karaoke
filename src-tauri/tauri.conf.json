{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Karaoke",
  "version": "0.1.0",
  "identifier": "app.openkaraoke.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Karaoke",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0b0a10",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Open-source karaoke studio with real-time autotune",
    "longDescription": "Search any song, sing over its instrumental with synced lyrics, and shape your voice with a low-latency autotune, harmonizer and vocal effects.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Open Karaoke contributors",
    "copyright": "© 2026 Open Karaoke contributors. MIT License.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 190 },
        "applicationFolderPosition": { "x": 440, "y": 190 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": ["libasound2"] },
      "rpm": { "depends": ["alsa-lib"] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
